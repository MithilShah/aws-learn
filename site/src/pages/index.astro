---
// /aws/ — hub page listing every service journey. Task 11 writes the
// final copy.
import BaseLayout from '../layouts/BaseLayout.astro';
import { HUB_DESCRIPTION, HUB_TITLE, SECTION_NAME } from '../data/site';
import { getJourneys } from '../lib/content';
import { overviewPath } from '../lib/journey';
import { itemList } from '../lib/seo';
import { absUrl, withBase } from '../lib/urls';

const journeys = await getJourneys();
const jsonLd = [itemList(journeys.map(({ overview, service }) => ({ name: overview.data.title, url: absUrl(overviewPath(service.id)) })))];
---
<BaseLayout title={HUB_TITLE} description={HUB_DESCRIPTION} ogType="website" jsonLd={jsonLd}>
  <article class="prose">
    <h1>{SECTION_NAME}</h1>
    <p class="lede">
      Step-by-step, beginner-friendly guides to AWS services. Each journey explains one service
      with interactive diagrams, and every fact is checked against the official AWS documentation.
    </p>
    <h2>Journeys</h2>
    <ul class="journey-cards">
      {journeys.map(({ service, overview, steps }) => (
        <li class="journey-card">
          <h3><a href={withBase(overviewPath(service.id))}>{service.name}</a></h3>
          <p>{overview.data.summary}</p>
          <p class="journey-meta">Beginner · {steps.length} {steps.length === 1 ? 'step' : 'steps'}</p>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
