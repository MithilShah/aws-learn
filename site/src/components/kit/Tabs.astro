---
// Tabbed panels. Every panel is in the HTML: without JavaScript (and for
// search engines) they show one after another, each under its own heading.
// src/scripts/tabs.ts turns them into WAI-ARIA tabs.
//   <Tabs label="Ways to use AWS Config">
//     <TabPanel label="Resource administration">…</TabPanel>
//     <TabPanel label="Security analysis">…</TabPanel>
//   </Tabs>
interface Props {
  /** Accessible name for the tab list. */
  label: string;
}

const { label } = Astro.props;
---
<div class="tabs" data-tabs data-tabs-label={label}><slot /></div>

<script>
  import '../../scripts/tabs';
</script>

<style>
  .tabs { margin: 24px 0; }
  .tabs :global([role='tablist']) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    border-bottom: 2px solid var(--border);
  }
  .tabs :global([role='tab']) {
    margin-bottom: -2px;
    padding: 9px 14px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font: 600 15px/1.3 var(--font-sans);
    color: var(--ink-2);
    cursor: pointer;
  }
  .tabs :global([role='tab']:hover) { color: var(--w-violet); }
  .tabs :global([role='tab'][aria-selected='true']) {
    border-bottom-color: var(--w-violet);
    color: var(--w-violet);
  }
</style>
