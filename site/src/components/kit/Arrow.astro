---
// An arrow between two points in a <Diagram>, with an optional label.
// Points are [x, y] pairs; use anchor() from lib/diagram in .astro visuals
// to attach arrows to a ServiceNode's sides.
//   <Arrow from={[180, 68]} to={[260, 68]} label="change" stage="2" />
import { arrowGeometry, type Point } from '../../lib/diagram';

type XY = Point | [number, number];

interface Props {
  from: XY;
  to: XY;
  label?: string;
  dashed?: boolean;
  /** Stepper stages that light this arrow. */
  stage?: string;
  stageFrom?: number;
}

const toPoint = (p: XY): Point => (Array.isArray(p) ? { x: p[0], y: p[1] } : p);
const { from, to, label, dashed = false, stage, stageFrom } = Astro.props;
const geo = arrowGeometry(toPoint(from), toPoint(to));
---
{geo && (
  <g class="diagram-arrow" data-stage={stage} data-stage-from={stageFrom}>
    <line
      x1={geo.line.x1}
      y1={geo.line.y1}
      x2={geo.line.x2}
      y2={geo.line.y2}
      stroke-dasharray={dashed ? '6 5' : undefined}
    />
    <polygon points={geo.head} />
    {label && (
      <text class="arrow-label" x={geo.mid.x} y={geo.mid.y - 9} text-anchor="middle">{label}</text>
    )}
  </g>
)}

<style>
  .diagram-arrow line { stroke: var(--ink-2); stroke-width: 2; }
  .diagram-arrow polygon { fill: var(--ink-2); }
  .arrow-label { fill: var(--ink-2); font-size: 12.5px; font-weight: 600; paint-order: stroke; stroke: #fff; stroke-width: 4px; }
</style>
