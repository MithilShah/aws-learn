---
// Layout for every page inside a journey: the overview (slug = null) and
// each step. Adds the journey sidebar, breadcrumbs, a "Step N of M" eyebrow,
// the page's sources and prev/next links around the MDX content passed in
// the default slot. The article is what Pagefind indexes.
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';
import Sidebar from '../components/Sidebar.astro';
import Sources from '../components/Sources.astro';
import { SECTION_NAME } from '../data/site';
import type { JourneyEntry } from '../lib/content';
import { neighbors, overviewPath, stepPath, stepSlug, stepNumber, type Journey } from '../lib/journey';
import { breadcrumbList, course, shareImagePath, techArticle, type JsonLd, type NamedUrl } from '../lib/seo';
import { absUrl, withBase } from '../lib/urls';

interface Props {
  journey: Journey<JourneyEntry>;
  entry: JourneyEntry;
  /** Step slug, or null for the journey overview. */
  slug: string | null;
  /** The MDX page's headings, for the sidebar's section outline. */
  headings?: MarkdownHeading[];
}

const { journey, entry, slug, headings = [] } = Astro.props;
const { service, steps } = journey;
const { title, navTitle, description, sources, lastVerified } = entry.data;

const hub: Crumb = { label: SECTION_NAME, href: withBase() };
const crumbs: Crumb[] =
  slug === null
    ? [hub, { label: service.name }]
    : [hub, { label: service.name, href: withBase(overviewPath(service.id)) }, { label: navTitle }];

const stepCount = `${steps.length} ${steps.length === 1 ? 'step' : 'steps'}`;
const eyebrow =
  slug === null
    ? `${service.name} · Beginner journey · ${stepCount}`
    : `${service.name} · Step ${stepNumber(journey, slug)} of ${steps.length}`;

const { prev, next } = neighbors(journey, slug);

// ---- SEO: share image + structured data ----
const siteOrigin = Astro.site!.href;
const pagePath = slug === null ? overviewPath(service.id) : stepPath(service.id, slug);
const ogImage = absUrl(shareImagePath(pagePath));
const overviewUrl: NamedUrl = { name: journey.overview.data.title, url: absUrl(overviewPath(service.id)) };
const trail: NamedUrl[] = [
  { name: SECTION_NAME, url: absUrl() },
  { name: service.name, url: overviewUrl.url },
  ...(slug === null ? [] : [{ name: navTitle, url: absUrl(pagePath) }]),
];
const jsonLd: JsonLd[] = [
  slug === null
    ? course({
        siteOrigin,
        url: overviewUrl.url,
        name: title,
        description,
        image: ogImage,
        about: service.name,
        steps: steps.map((s) => ({ name: s.data.title, url: absUrl(stepPath(service.id, stepSlug(s))) })),
      })
    : techArticle({
        siteOrigin,
        url: absUrl(pagePath),
        headline: title,
        description,
        image: ogImage,
        dateModified: lastVerified,
        about: service.name,
        course: overviewUrl,
        citations: sources.map((s) => ({ name: s.title, url: s.url })),
      }),
  breadcrumbList(trail),
];
---
<BaseLayout
  title={title}
  description={description}
  ogType={slug === null ? 'website' : 'article'}
  ogImage={ogImage}
  ogImageAlt={`${eyebrow}: ${title}`}
  jsonLd={jsonLd}
>
  <Sidebar slot="sidebar" journey={journey} currentSlug={slug} headings={headings} />
  <Breadcrumbs items={crumbs} />
  <article class="prose" data-pagefind-body data-pagefind-filter={`Journey:${service.name}`}>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <slot />
    {slug !== null && (
      // Reaching this point marks the step done (src/scripts/progress.ts).
      <div class="read-sentinel" data-read-sentinel data-service={service.id} data-step={slug} aria-hidden="true"></div>
    )}
    <Sources sources={sources} lastVerified={lastVerified} />
  </article>
  <PrevNext prev={prev} next={next} nextKicker={slug === null ? 'Start the journey' : 'Next'} />
</BaseLayout>
